# ─────────────────────────────────────────────────────────────
# NoteKart environment variables
# Copy to .env.local and fill in. Never commit real secrets.
# ─────────────────────────────────────────────────────────────

# Database (Neon Postgres) — required
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Public site URL, used to build payment redirect URLs — required in production
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Session signing + OTP hashing — REQUIRED. Generate with:
#   openssl rand -base64 32
SESSION_SECRET=

# Comma-separated 10-digit admin mobile numbers that may access /admin
ADMIN_MOBILES=

# Public WhatsApp help button (10-digit Indian number or full country-code number)
NEXT_PUBLIC_WHATSAPP_NUMBER=9461217285

# ── OTP delivery (SMS) ──────────────────────────────────────────
# Pick a provider. If none is configured, in development the OTP is
# printed to the server console (and returned as devCode) so login is
# still testable. In production you MUST configure a provider.
# SMS_PROVIDER=msg91   # or "twilio"; auto-detected from the keys below if unset
# SMS_COUNTRY_CODE=91

# MSG91 (default for India). Template variable should map to the OTP.
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=

# MSG91 OTP Widget (recommended for this project)
# Public values used by the browser widget:
NEXT_PUBLIC_MSG91_WIDGET_ID=
NEXT_PUBLIC_MSG91_WIDGET_TOKEN=
# Server-side auth key used to verify the widget's access-token:
# MSG91_AUTH_KEY=

# Twilio (alternative)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ── Payments ────────────────────────────────────────────────────
# Admin can switch the active gateway in /admin. Default is Cashfree.
PAYMENT_GATEWAY=cashfree

# Cashfree PG. Leave blank to run checkout in demo/mock mode.
CASHFREE_ENV=production   # or "sandbox"
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_API_VERSION=2023-08-01

# PhonePe PG. Leave blank to run checkout in demo/mock mode.
PHONEPE_ENV=sandbox   # or "production"
PHONEPE_CLIENT_ID=
PHONEPE_CLIENT_SECRET=
PHONEPE_CLIENT_VERSION=1

# Razorpay placeholder for future checkout enablement.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ── Media uploads (Cloudinary) ──────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_URL=

# ── Shipping / tracking (optional) ──────────────────────────────
DELHIVERY_API_TOKEN=
DELHIVERY_ENV=test    # or "production"
DELHIVERY_PICKUP_LOCATION=NoteKart
DELHIVERY_SHIPPING_MODE=Surface
DELHIVERY_DEFAULT_WEIGHT_GRAMS=500
DELHIVERY_SELLER_GST_TIN=
DELHIVERY_HSN_CODE=
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
